	partition CheckValues = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "check_values.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty CSV cells (no gross margin, unreported quarters) become nulls before typing.
				    Blanks = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Ticker", type text}, {"Vintage", Int64.Type}, {"RevenueVariance", type number}, {"RevenueVariancePct", type number}, {"OperatingIncomeVariance", type number}, {"BridgeRevenueEffect", type number}, {"BridgeMarginEffect", type number}, {"BridgeGrossMarginEffect", type number}, {"BridgeOpexEffect", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

