	partition DimPeriod = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_period.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty CSV cells (no gross margin, unreported quarters) become nulls before typing.
				    Blanks = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"PeriodKey", type text}, {"Ticker", type text}, {"FiscalYear", Int64.Type}, {"FiscalQuarter", Int64.Type}, {"PeriodStart", type date}, {"PeriodEnd", type date}, {"IsReported", type logical}, {"FiscalLabel", type text}}, "en-US"),
				    #"Added PeriodSort" = Table.AddColumn(Typed, "PeriodSort", each [FiscalYear] * 10 + [FiscalQuarter], Int64.Type)
				in
				    #"Added PeriodSort"

	annotation PBI_ResultType = Table

