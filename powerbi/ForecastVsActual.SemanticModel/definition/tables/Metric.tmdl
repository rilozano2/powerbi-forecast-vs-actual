				    ("Revenue", NAMEOF ( '_Measures'[Revenue Actual] ), 0),
				    ("Gross profit", NAMEOF ( '_Measures'[Gross Profit Actual] ), 1),
				    ("Operating income", NAMEOF ( '_Measures'[Operating Income Actual] ), 2),
				    ("Net income", NAMEOF ( '_Measures'[Net Income Actual] ), 3),
				    ("Operating margin", NAMEOF ( '_Measures'[Operating Margin (reported)] ), 4),
				    ("Revenue TTM", NAMEOF ( '_Measures'[Revenue TTM] ), 5)
				}

	annotation PBI_Id = 5a825262bcd05b44ba3d34d162ff5669

