/// Field parameter: pick which metric the trend chart shows.
table Metric
	lineageTag: c2fc2d05-5c2c-5f49-96e8-1ff8272aecd0

	column Metric
		lineageTag: ff48858b-bf60-5894-a2df-b86144bb25e3
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'Metric Order'

		relatedColumnDetails
			groupByColumn: 'Metric Fields'

		annotation SummarizationSetBy = Automatic

	column 'Metric Fields'
		isHidden
		lineageTag: f1b08733-66ce-5f74-94b8-5cdd05700b2f
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'Metric Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

