	partition FactActuals = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_actuals.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty CSV cells (no gross margin, unreported quarters) become nulls before typing.
				    Blanks = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Ticker", type text}, {"PeriodKey", type text}, {"FiscalYear", Int64.Type}, {"FiscalQuarter", Int64.Type}, {"PeriodStart", type date}, {"PeriodEnd", type date}, {"Revenue", type number}, {"CostOfRevenue", type number}, {"GrossProfit", type number}, {"OperatingExpenses", type number}, {"OperatingIncome", type number}, {"NetIncome", type number}, {"OperatingIncomeIsPreTax", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

