	/// TRUE on rows from each company's most recent forecast vintage (the current fiscal year).
	column 'Is Latest Vintage Row' = FactForecast[Vintage] = CALCULATE ( MAX ( FactForecast[Vintage] ), ALLEXCEPT ( FactForecast, FactForecast[Ticker] ) )
		dataType: boolean
		isHidden
		lineageTag: dfde1deb-e68a-5395-a459-4b18453dab73
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition FactForecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_forecast.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty CSV cells (no gross margin, unreported quarters) become nulls before typing.
				    Blanks = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Ticker", type text}, {"Vintage", Int64.Type}, {"PeriodKey", type text}, {"FiscalYear", Int64.Type}, {"FiscalQuarter", Int64.Type}, {"Revenue", type number}, {"GrossProfit", type number}, {"OperatingExpenses", type number}, {"OperatingIncome", type number}, {"NetIncome", type number}, {"BaseRevenue", type number}, {"RevenueGrowth", type number}, {"OperatingMargin", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

