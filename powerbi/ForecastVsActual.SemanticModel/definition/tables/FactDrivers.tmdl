	partition FactDrivers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_drivers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty CSV cells (no gross margin, unreported quarters) become nulls before typing.
				    Blanks = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"Ticker", type text}, {"Vintage", Int64.Type}, {"OriginPeriodEnd", type date}, {"RevenueGrowth", type number}, {"GrossMargin", type number}, {"OpexPct", type number}, {"OperatingMargin", type number}, {"NetMargin", type number}, {"HasGrossMargin", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

