{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "peer_scatter",
  "position": {
    "x": 24,
    "y": 100,
    "z": 4000,
    "height": 600,
    "width": 600,
    "tabOrder": 4000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCompany"
                    }
                  },
                  "Property": "Company"
                }
              },
              "queryRef": "DimCompany.Company",
              "active": true,
              "displayName": "Company"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue YoY %"
                }
              },
              "queryRef": "_Measures.Revenue YoY %",
              "active": true,
              "displayName": "Revenue growth"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Operating Margin (reported)"
                }
              },
              "queryRef": "_Measures.Operating Margin (reported)",
              "displayName": "Operating margin"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryLabels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue growth (x) vs operating margin (y)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}