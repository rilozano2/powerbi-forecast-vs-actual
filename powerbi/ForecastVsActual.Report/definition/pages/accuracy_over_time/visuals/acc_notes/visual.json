                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "NVIDIA FY2024: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the AI data center boom. Revenue came in about 92% above a forecast built on the prior trend.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "NRG 2021: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the Direct Energy acquisition closed in January 2021.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Robinhood 2023: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the forecast extrapolated the 2022 slump, then higher rates lifted interest income.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Schwab 2021: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the first full year after buying TD Ameritrade.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "AMD 2023: ",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "the PC downturn.",
                    "textStyle": {
                      "fontSize": "10pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The lesson: a trend-based driver model is a strong baseline for steady businesses, and needs judgment overlays for M&A, rate regimes and product cycles.",
