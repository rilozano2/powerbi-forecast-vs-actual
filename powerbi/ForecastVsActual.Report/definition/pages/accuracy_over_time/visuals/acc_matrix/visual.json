{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "acc_matrix",
  "position": {
    "x": 24,
    "y": 100,
    "z": 2000,
    "height": 400,
    "width": 880,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCompany"
                    }
                  },
                  "Property": "Company"
                }
              },
              "queryRef": "DimCompany.Company",
              "active": true,
              "displayName": "Company"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimPeriod"
                    }
                  },
                  "Property": "FiscalYear"
                }
              },
              "queryRef": "DimPeriod.FiscalYear",
              "active": true,
              "displayName": "Fiscal year"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue Variance % (full years)"
                }
              },
              "queryRef": "_Measures.Revenue Variance % (full years)",
              "displayName": "Variance %"
            }
          ]
        }
      }
    },
    "objects": {
      "values": [
        {
          "properties": {
            "backColor": {
              "solid": {
                "color": {
                  "expr": {
                    "FillRule": {
                      "Input": {
                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "_Measures"
                            }
                          },
                          "Property": "Revenue Variance % (full years)"
                        }
                      },
                      "FillRule": {
                        "linearGradient3": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#E8746A'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "-0.3D"
                              }
                            }
                          },
                          "mid": {
                            "color": {
                              "Literal": {
                                "Value": "'#FFFFFF'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "0D"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#63B57A'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "0.3D"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'noColor'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "_Measures.Revenue Variance % (full years)"
          }
        }
      ],
      "subTotals": [
        {
          "properties": {
            "rowSubtotals": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "columnSubtotals": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Revenue variance % (complete fiscal years)'"
                }
