{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "summary_bar",
  "position": {
    "x": 24,
    "y": 230,
    "z": 7000,
    "height": 470,
    "width": 600,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimCompany"
                    }
                  },
                  "Property": "Company"
                }
              },
              "queryRef": "DimCompany.Company",
              "active": true,
              "displayName": "Company"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue MAPE (company-years)"
                }
              },
              "queryRef": "_Measures.Revenue MAPE (company-years)",
              "displayName": "Model"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Revenue MAPE (naive)"
                }
              },
              "queryRef": "_Measures.Revenue MAPE (naive)",
              "displayName": "Same as last year"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "_Measures"
                  }
                },
                "Property": "Revenue MAPE (company-years)"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "labelDisplayUnits": {
              "expr": {
                "Literal": {
                  "Value": "1D"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Average revenue miss by company: model vs naive (lower is better)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}